---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: {
      category: article.data.category,
      slug: article.id,
    },
    props: { article },
  }));
}

const { article } = Astro.props;
const allArticles = await getCollection('articles');
const { Content, headings } = await render(article);
const relatedArticles = allArticles
  .filter((candidate) => candidate.id !== article.id)
  .map((candidate) => ({
    article: candidate,
    sharedTags: candidate.data.tags.filter((tag) => article.data.tags.includes(tag)).length,
  }))
  .filter(({ article: candidate, sharedTags }) => candidate.data.category === article.data.category || sharedTags > 0)
  .sort((a, b) => b.sharedTags - a.sharedTags || b.article.data.pubDate.valueOf() - a.article.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ article: candidate }) => ({
    title: candidate.data.title,
    description: candidate.data.description,
    category: candidate.data.category,
    slug: candidate.id,
  }));
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  category={article.data.category}
  pubDate={article.data.pubDate}
  author={article.data.author}
  image={article.data.image}
  imageAlt={article.data.imageAlt}
  imageCredit={article.data.imageCredit}
  imageLicense={article.data.imageLicense}
  imageCreator={article.data.imageCreator}
  imageLicensePage={article.data.imageLicensePage}
  tags={article.data.tags}
  sources={article.data.sources}
  updatedDate={article.data.updatedDate}
  reviewedDate={article.data.reviewedDate}
  reviewedBy={article.data.reviewedBy}
  headings={headings}
  relatedArticles={relatedArticles}
>
  <Content />
</ArticleLayout>
