---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto"
  description="Ponte en contacto con el equipo de redacción y soporte de EcoCuriosa."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-lg p-6 sm:p-10 border border-[#e6e2d8] shadow-xs">
      <h1 class="font-serif font-bold text-3xl sm:text-4xl text-[#063b1e] mb-4 leading-tight sm:leading-snug">
        Contacta con Nosotros
      </h1>
      <p class="text-[#444a46] mb-8 max-w-2xl leading-relaxed">
        ¿Tienes alguna consulta científica, sugerencia sobre nuestros artículos, propuesta de colaboración o duda técnica? Nuestro equipo revisa todos los mensajes con atención.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        
        <div class="md:col-span-2">
          <h2 class="sr-only">Formulario de Comunicación Directa</h2>
          <p class="text-sm text-[#5a605c] mb-4">
            Al enviar se abrirá tu aplicación de correo con el mensaje preparado. Revísalo y confírmalo allí para que llegue al equipo editorial.
          </p>
          <form id="contact-form" class="space-y-4">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase text-[#141715] mb-1">
                Nombre o seudónimo *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ej. María González"
                class="w-full px-4 py-2.5 rounded-md border border-[#e6e2d8] text-sm text-[#141715] bg-[#fbf9f4]/40 focus:outline-none focus:ring-2 focus:ring-[#063b1e] focus:border-transparent"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold uppercase text-[#141715] mb-1">
                Correo Electrónico *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tucorreo@ejemplo.com"
                class="w-full px-4 py-2.5 rounded-md border border-[#e6e2d8] text-sm text-[#141715] bg-[#fbf9f4]/40 focus:outline-none focus:ring-2 focus:ring-[#063b1e] focus:border-transparent"
              />
            </div>

            <div>
              <label for="subject" class="block text-xs font-semibold uppercase text-[#141715] mb-1">
                Asunto
              </label>
              <select
                id="subject"
                name="subject"
                class="w-full px-4 py-2.5 rounded-md border border-[#e6e2d8] text-sm text-[#141715] focus:outline-none focus:ring-2 focus:ring-[#063b1e] focus:border-transparent bg-white"
              >
                <option value="general">Consulta general / Duda sobre artículo</option>
                <option value="correction">Sugerencia de corrección o errata</option>
                <option value="collab">Propuesta de colaboración editorial</option>
                <option value="privacy">Asuntos de privacidad / Derechos de datos</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase text-[#141715] mb-1">
                Mensaje *
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Escribe aquí los detalles de tu consulta..."
                class="w-full px-4 py-2.5 rounded-md border border-[#e6e2d8] text-sm text-[#141715] bg-[#fbf9f4]/40 focus:outline-none focus:ring-2 focus:ring-[#063b1e] focus:border-transparent"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto bg-[#063b1e] hover:bg-[#042613] text-[#fbf9f4] font-medium text-sm px-6 py-3 rounded-md shadow-xs transition-colors"
            >
              Enviar Mensaje
            </button>
            <p id="contact-form-status" class="text-sm text-[#5a605c]" aria-live="polite"></p>
          </form>
        </div>

        <div class="border-t md:border-t-0 md:border-l border-[#e6e2d8] md:pl-8 pt-6 md:pt-0 text-sm space-y-6">
          <div>
            <h2 class="font-serif font-bold text-[#063b1e] text-lg mb-1">Canales Directos</h2>
            <p class="text-xs text-[#5a605c] mb-3">Respuestas en menos de 24 a 48 horas hábiles.</p>
            
            <div class="space-y-3 text-[#141715]">
              <div class="flex flex-col">
                <span class="font-semibold text-xs uppercase text-[#5a605c]">Redacción:</span>
                <a href="mailto:contacto@ecocuriosa.com" class="text-sm text-[#063b1e] hover:text-[#946c07] font-medium underline">
                  contacto@ecocuriosa.com
                </a>
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-xs uppercase text-[#5a605c]">Privacidad:</span>
                <a href="mailto:privacidad@ecocuriosa.com" class="text-sm text-[#063b1e] hover:text-[#946c07] font-medium underline">
                  privacidad@ecocuriosa.com
                </a>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-[#e6e2d8]">
            <h3 class="font-serif font-bold text-[#141715] text-sm mb-1">Compromiso de Respuesta</h3>
            <p class="text-xs text-[#5a605c] leading-relaxed">
              Nos comprometemos a responder cada comunicación de forma personalizada. No utilizamos respuestas automáticas genéricas.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector('#contact-form');
  const status = document.querySelector('#contact-form-status');

  if (form instanceof HTMLFormElement && status) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const subject = String(data.get('subject') ?? 'general');
      const message = String(data.get('message') ?? '').trim();
      const mailSubject = `EcoCuriosa: ${subject}`;
      const mailBody = `Nombre: ${name}\nCorreo: ${email}\nAsunto: ${subject}\n\n${message}`;

      status.textContent = 'Abriendo tu aplicación de correo…';
      window.location.href = `mailto:contacto@ecocuriosa.com?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
    });
  }
</script>
