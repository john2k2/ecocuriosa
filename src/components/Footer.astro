---
const categories = [
  { name: 'Fauna Fascinante', href: '/fauna-fascinante' },
  { name: 'Especies Marinas', href: '/especies-marinas' },
  { name: 'Fenómenos Naturales', href: '/fenomenos-naturales' },
  { name: 'Ciencia Curiosa', href: '/ciencia-curiosa' },
];

const legalLinks = [
  { name: 'Política de Privacidad', href: '/politica-de-privacidad' },
  { name: 'Política de Cookies', href: '/politica-de-cookies' },
  { name: 'Aviso Legal', href: '/aviso-legal' },
  { name: 'Contacto', href: '/contacto' },
  { name: 'Sobre Nosotros', href: '/sobre-nosotros' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#052212] text-[#d0ded5] mt-24 border-t border-[#08301a]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-14">
      
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded bg-[#0f5128] text-[#fbf9f4] flex items-center justify-center font-serif font-bold text-xl shadow-xs">
            E
          </div>
          <span class="font-serif font-bold text-2xl text-[#fbf9f4] tracking-tight">EcoCuriosa</span>
        </div>
        <p class="text-sm text-[#a3b8ad] max-w-md leading-relaxed mb-6 font-light">
          Enciclopedia digital e independiente dedicada a documentar la biodiversidad terrestre y marina, los enigmas de la geofísica y la ciencia del mundo vivo con rigor editorial.
        </p>
        <span class="text-xs text-[#c59b27] font-semibold tracking-wide">
          Divulgación científica • Archivo Documental
        </span>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-[#fbf9f4] tracking-widest uppercase mb-4 pb-2 border-b border-[#08301a]">
          Cuadernos de Campo
        </h3>
        <ul class="space-y-2.5 text-sm">
          {categories.map((cat) => (
            <li>
              <a href={cat.href} class="hover:text-[#c59b27] transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-[#fbf9f4] tracking-widest uppercase mb-4 pb-2 border-b border-[#08301a]">
          Información Legal
        </h3>
        <ul class="space-y-2.5 text-sm">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#c59b27] transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="pt-8 border-t border-[#08301a] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#738a7d]">
      <p>&copy; {currentYear} EcoCuriosa. Todos los derechos reservados.</p>
      <p>Compromiso con la accesibilidad universal y la lectura sin distracciones.</p>
    </div>
  </div>
</footer>
