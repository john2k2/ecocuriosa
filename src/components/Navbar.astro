---
const categories = [
  { name: 'Fauna Fascinante', href: '/fauna-fascinante' },
  { name: 'Especies Marinas', href: '/especies-marinas' },
  { name: 'Fenómenos Naturales', href: '/fenomenos-naturales' },
  { name: 'Ciencia Curiosa', href: '/ciencia-curiosa' },
];

const currentPath = Astro.url.pathname;
---

<!-- Barra superior de edición de expedición -->
<div class="bg-[#052212] text-[#e3ded2] text-xs py-1.5 px-4 border-b border-[#08301a]">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#c59b27]"></span>
      <span class="font-medium tracking-wide">Vol. I · Revista Digital de Expedición &amp; Biodiversidad</span>
    </div>
    <div class="hidden sm:flex items-center gap-4 text-stone-300">
      <span>Archivo Evergreen</span>
      <span>•</span>
      <span>Edición y divulgación</span>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-[#fbf9f4]/95 backdrop-blur border-b border-[#e6e2d8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logotipo e Identidad de Expedición -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded bg-[#063b1e] text-[#fbf9f4] flex items-center justify-center font-serif font-bold text-2xl shadow-sm group-hover:bg-[#042613] transition-colors">
          E
        </div>
        <div class="flex flex-col">
          <span class="font-serif font-bold text-2xl tracking-tight text-[#141715] group-hover:text-[#063b1e] transition-colors leading-none">
            EcoCuriosa
          </span>
          <span class="text-xs tracking-widest uppercase text-[#946c07] font-semibold mt-1">
            Cuaderno de Ciencias Naturales
          </span>
        </div>
      </a>

      <!-- Navegación Temática -->
      <nav class="hidden md:flex items-center gap-2 text-sm font-medium">
        {categories.map((cat) => {
          const isActive = currentPath.startsWith(cat.href);
          return (
            <a
              href={cat.href}
              class={`px-4 py-2 rounded-md transition-all ${
                isActive
                  ? 'text-[#063b1e] bg-[#eaf3ec] font-semibold shadow-xs'
                  : 'text-[#141715] hover:text-[#063b1e] hover:bg-[#efece3]'
              }`}
            >
              {cat.name}
            </a>
          );
        })}
      </nav>

      <!-- Botón de Menú Móvil -->
      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-md text-[#141715] hover:bg-[#efece3] focus:outline-none focus:ring-2 focus:ring-[#063b1e]"
          aria-label="Abrir navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Menú desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#e6e2d8] bg-[#fbf9f4] px-4 pt-3 pb-5 space-y-2">
    {categories.map((cat) => (
      <a
        href={cat.href}
        class="block px-3 py-2.5 rounded-md text-base font-medium text-[#141715] hover:bg-[#eaf3ec] hover:text-[#063b1e]"
      >
        {cat.name}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const toggleMenu = (expand?: boolean) => {
      const isExpanded = typeof expand === 'boolean' ? !expand : btn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      btn.setAttribute('aria-expanded', String(nextState));
      btn.setAttribute('aria-label', nextState ? 'Cerrar navegación' : 'Abrir navegación');
      if (nextState) {
        menu.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
      }
    };

    btn.addEventListener('click', () => toggleMenu());

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
        btn.focus();
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });
  }
</script>
