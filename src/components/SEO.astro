---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageCredit?: string;
  imageLicense?: string;
  imageCreator?: string;
  imageLicensePage?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modifiedDate?: Date;
  reviewedDate?: Date;
  reviewedBy?: string;
  author?: string;
  category?: string;
  tags?: string[];
  sources?: {
    title: string;
    url: string;
    publisher?: string;
    accessedDate?: Date;
    evidenceType?: 'primary' | 'review' | 'dataset' | 'institutional' | 'secondary';
    scope?: string;
  }[];
  faqs?: {
    question: string;
    answer: string;
  }[];
  pageType?: 'website' | 'collection' | 'about';
  collectionItems?: {
    name: string;
    url: string;
  }[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/images/og-default.webp',
  imageAlt,
  imageCredit,
  imageLicense,
  imageCreator,
  imageLicensePage,
  canonicalURL = Astro.url.href,
  type = 'website',
  pubDate,
  modifiedDate,
  reviewedDate,
  reviewedBy,
  author = 'Equipo Editorial EcoCuriosa',
  category,
  tags = [],
  sources = [],
  faqs = [],
  pageType = 'website',
  collectionItems = [],
  noindex = false,
} = Astro.props;

const fullTitle = title.includes('EcoCuriosa') ? title : `${title} | EcoCuriosa`;
// SVG keeps the article page light; social crawlers receive the matching WebP.
const socialImage = image.endsWith('.svg') ? image.replace(/\.svg$/i, '.webp') : image;
const socialImageURL = new URL(socialImage, Astro.site).href;
const socialImageType = /\.jpe?g$/i.test(socialImage)
  ? 'image/jpeg'
  : /\.png$/i.test(socialImage)
    ? 'image/png'
    : 'image/webp';
const siteURL = Astro.site?.href || 'https://ecocuriosa.com/';
const imageObject = {
  "@type": "ImageObject",
  "url": socialImageURL,
  "caption": imageAlt || title,
  "representativeOfPage": true,
  ...(imageCredit ? { "creditText": imageCredit } : {}),
  ...(imageLicense ? { "license": imageLicense } : {}),
  ...(imageCreator ? { "creator": imageCreator } : {}),
  ...(imageLicensePage ? { "acquireLicensePage": imageLicensePage } : {})
};
const organizationId = new URL('/#organization', siteURL).href;
const websiteId = new URL('/#website', siteURL).href;
const editorialProfileURL = new URL('/sobre-nosotros/', siteURL).href;
const publishingPrinciplesURL = new URL('/metodologia-editorial/', siteURL).href;
const categoryNames: Record<string, string> = {
  'fauna-fascinante': 'Fauna Fascinante',
  'especies-marinas': 'Especies Marinas',
  'fenomenos-naturales': 'Fenómenos Naturales',
  'ciencia-curiosa': 'Ciencia Curiosa',
};
const isEditorialTeam = author === 'Equipo Editorial EcoCuriosa';
const editor = reviewedDate && reviewedBy ? {
  "@type": reviewedBy === 'Equipo Editorial EcoCuriosa' ? 'Organization' : 'Person',
  "name": reviewedBy,
  ...(reviewedBy === 'Equipo Editorial EcoCuriosa' ? { "url": editorialProfileURL } : {})
} : undefined;

const organization = {
  "@type": "Organization",
  "@id": organizationId,
  "name": "EcoCuriosa",
  "url": siteURL,
  "description": "Enciclopedia digital independiente de divulgación científica sobre biodiversidad, océanos, geología y fenómenos naturales.",
  "logo": {
    "@type": "ImageObject",
    "url": new URL('/images/logo.webp', siteURL).href
  },
  "email": "privacidad@ecocuriosa.com",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "consultas editoriales y privacidad",
    "email": "contacto@ecocuriosa.com",
    "availableLanguage": "es"
  },
  "publishingPrinciples": publishingPrinciplesURL,
  "knowsAbout": ["Biodiversidad", "Ciencias naturales", "Océanos", "Geología", "Divulgación científica"]
};

const website = {
  "@type": "WebSite",
  "@id": websiteId,
  "url": siteURL,
  "name": "EcoCuriosa",
  "alternateName": "Cuaderno de Ciencias Naturales",
  "publisher": { "@id": organizationId },
  "inLanguage": "es",
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteURL}buscar/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const page = {
  "@type": pageType === 'about' ? 'AboutPage' : pageType === 'collection' ? 'CollectionPage' : 'WebPage',
  "@id": canonicalURL,
  "url": canonicalURL,
  "name": fullTitle,
  "description": description,
  "isPartOf": { "@id": websiteId },
  "inLanguage": "es",
  ...(pageType === 'about' ? { "mainEntity": { "@id": organizationId } } : {})
};

// Category pages expose their visible article index as an ItemList. The list
// is generated from the same collection used to render the cards, so it cannot
// drift from the links a reader sees. This is an additional semantic aid; it
// is not a promise of a rich result or of improved ranking.
const collectionItemList = pageType === 'collection' && collectionItems.length ? {
  "@type": "ItemList",
  "@id": `${canonicalURL}#itemlist`,
  "name": title,
  "url": canonicalURL,
  "numberOfItems": collectionItems.length,
  "itemListOrder": "https://schema.org/ItemListOrderAscending",
  "itemListElement": collectionItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "url": new URL(item.url, siteURL).href,
  })),
} : undefined;

const pageWithCollection = collectionItemList
  ? { ...page, "mainEntity": { "@id": `${canonicalURL}#itemlist` } }
  : page;

// The About page is also the organization's public profile. Keep this linked
// to the same verified Organization entity instead of inventing individual
// authors, credentials or social identities.
const profile = pageType === 'about' ? {
  "@type": "ProfilePage",
  "@id": `${canonicalURL}#profile`,
  "url": canonicalURL,
  "name": fullTitle,
  "isPartOf": { "@id": websiteId },
  "mainEntity": { "@id": organizationId },
  "inLanguage": "es"
} : undefined;

const article = type === 'article' ? {
  "@type": "Article",
  "@id": `${canonicalURL}#article`,
  "headline": title,
  "description": description,
  "image": imageObject,
  "datePublished": pubDate?.toISOString(),
  ...(modifiedDate ? { "dateModified": modifiedDate.toISOString() } : {}),
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "articleSection": category ? categoryNames[category] || category : undefined,
  "keywords": tags.join(', ') || undefined,
  "author": isEditorialTeam
    ? { "@type": "Organization", "name": author, "url": editorialProfileURL }
    : { "@type": "Person", "name": author },
  ...(editor ? { "editor": editor } : {}),
  "publisher": { "@id": organizationId },
  "mainEntityOfPage": { "@id": canonicalURL },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["#article-summary"]
  },
  ...(faqs.length ? { "subjectOf": { "@id": `${canonicalURL}#faq` } } : {}),
  ...(sources.length ? { "citation": sources.map((source) => source.url) } : {})
} : undefined;

// FAQ answers are parsed from the visible FAQ section in the article body.
// Keeping the same text in HTML and JSON-LD avoids inventing a second editorial
// version and makes the markup useful to non-Google consumers as well. Google
// does not guarantee an FAQ rich result for general publisher sites.
const faqPage = faqs.length ? {
  "@type": "FAQPage",
  "@id": `${canonicalURL}#faq`,
  "url": canonicalURL,
  "isPartOf": { "@id": websiteId },
  "inLanguage": "es",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
} : undefined;

const breadcrumbs = type === 'article' && category ? {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteURL },
    { "@type": "ListItem", "position": 2, "name": categoryNames[category] || category, "item": new URL(`/${category}/`, siteURL).href },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonicalURL }
  ]
} : undefined;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [organization, website, pageWithCollection, ...(profile ? [profile] : []), ...(article ? [article] : []), ...(faqPage ? [faqPage] : []), ...(breadcrumbs ? [breadcrumbs] : []), ...(collectionItemList ? [collectionItemList] : [])]
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content={noindex ? 'noindex, follow, max-image-preview:large' : 'max-image-preview:large'} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:alt" content={imageAlt || title} />
<meta property="og:image:type" content={socialImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="750" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="EcoCuriosa" />
{type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{type === 'article' && modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{type === 'article' && category && <meta property="article:section" content={categoryNames[category] || category} />}
{type === 'article' && <meta property="article:author" content={editorialProfileURL} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:image:alt" content={imageAlt || title} />

<!-- Structured Data (Schema.org) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
