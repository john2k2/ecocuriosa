---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { ADSENSE_CLIENT_ID, ADSENSE_ENABLED } from '../config/ads';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modifiedDate?: Date;
  reviewedDate?: Date;
  reviewedBy?: string;
  author?: string;
  category?: string;
  tags?: string[];
  sources?: {
    title: string;
    url: string;
    publisher?: string;
    accessedDate?: Date;
    evidenceType?: 'primary' | 'review' | 'dataset' | 'institutional' | 'secondary';
    scope?: string;
  }[];
  faqs?: {
    question: string;
    answer: string;
  }[];
  imageCredit?: string;
  imageLicense?: string;
  imageCreator?: string;
  imageLicensePage?: string;
  pageType?: 'website' | 'collection' | 'about';
  collectionItems?: {
    name: string;
    url: string;
  }[];
  noindex?: boolean;
  adsEnabled?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  pubDate,
  modifiedDate,
  reviewedDate,
  reviewedBy,
  author,
  category,
  tags,
  sources,
  faqs,
  imageCredit,
  imageLicense,
  imageCreator,
  imageLicensePage,
  pageType = 'website',
  collectionItems,
  noindex = false,
  adsEnabled = true,
} = Astro.props;

---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#052212" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="EcoCuriosa — nuevas monografías" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- AdSense puede verificar la propiedad mediante este meta tag sin descargar
         el runtime de anuncios mientras todavía no haya slots aprobados. -->
    {ADSENSE_CLIENT_ID && <meta name="google-adsense-account" content={ADSENSE_CLIENT_ID} />}

    <!-- Adelantamos las dos familias que usa el primer bloque visible. El
         navegador puede reutilizarlas desde la caché y evita una cadena CSS →
         fuente que retrase el texto que Lighthouse identifica como LCP. -->
    <link rel="preload" href="/fonts/literata-latin-v2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/albert-sans-latin-v2.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Metaetiquetas SEO y Schema.org -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      pubDate={pubDate}
      modifiedDate={modifiedDate}
      reviewedDate={reviewedDate}
      reviewedBy={reviewedBy}
      author={author}
      category={category}
      tags={tags}
      sources={sources}
      faqs={faqs}
      imageCredit={imageCredit}
      imageLicense={imageLicense}
      imageCreator={imageCreator}
      imageLicensePage={imageLicensePage}
      pageType={pageType}
      collectionItems={collectionItems}
      noindex={noindex}
    />

    {adsEnabled && ADSENSE_ENABLED && ADSENSE_CLIENT_ID && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#063b1e] focus:text-[#fbf9f4] focus:rounded-md">Saltar al contenido principal</a>
    <Navbar />
    
    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
