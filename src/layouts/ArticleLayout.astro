---
import BaseLayout from './BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import { ADSENSE_SLOTS } from '../config/ads';

interface Props {
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  author: string;
  image: string;
  imageAlt: string;
  imageCredit?: string;
  imageLicense?: string;
  imageCreator?: string;
  imageLicensePage?: string;
  tags?: string[];
  sources?: { title: string; url: string; publisher?: string; accessedDate?: Date }[];
  reviewedDate?: Date;
  reviewedBy?: string;
  headings?: { depth: number; slug: string; text: string }[];
  relatedArticles?: { title: string; description: string; category: string; slug: string }[];
}

const {
  title,
  description,
  category,
  pubDate,
  author,
  image,
  imageAlt,
  imageCredit,
  imageLicense,
  imageCreator,
  imageLicensePage,
  tags = [],
  sources = [],
  reviewedDate,
  reviewedBy,
  headings = [],
  relatedArticles = [],
} = Astro.props;

const categoryNames: Record<string, string> = {
  'fauna-fascinante': 'Fauna Fascinante',
  'especies-marinas': 'Especies Marinas',
  'fenomenos-naturales': 'Fenómenos Naturales',
  'ciencia-curiosa': 'Ciencia Curiosa',
};

const categoryLabel = categoryNames[category] || category;
const categoryUrl = `/${category}`;
const authorUrl = author === 'Equipo Editorial EcoCuriosa' ? '/sobre-nosotros/' : undefined;

const formattedDate = new Intl.DateTimeFormat('es-ES', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
const formattedReviewDate = reviewedDate && new Intl.DateTimeFormat('es-ES', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(reviewedDate);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  pubDate={pubDate}
  modifiedDate={reviewedDate}
  author={author}
  category={category}
  tags={tags}
  sources={sources}
  imageCredit={imageCredit}
  imageLicense={imageLicense}
  imageCreator={imageCreator}
  imageLicensePage={imageLicensePage}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <nav class="flex items-center gap-2 text-xs text-[#5a605c] mb-8" aria-label="Migas de pan">
      <a href="/" class="hover:text-[#063b1e] transition-colors">Inicio</a>
      <span>/</span>
      <a href={categoryUrl} class="hover:text-[#063b1e] transition-colors font-medium">{categoryLabel}</a>
      <span>/</span>
      <span class="text-[#141715] truncate max-w-xs">{title}</span>
    </nav>

    <header class="mb-10 text-left">
      <h1 class="font-serif font-bold text-3xl sm:text-4xl lg:text-5xl text-[#063b1e] tracking-tight leading-[1.12] mb-6">
        {title}
      </h1>

      <p class="text-xl sm:text-2xl text-[#141715]/85 leading-relaxed font-sans font-light mb-8 max-w-[70ch]">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-4 py-4 border-y border-[#e6e2d8] text-xs text-[#5a605c]">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded bg-[#063b1e] text-white flex items-center justify-center font-serif font-bold text-sm">
            {author.charAt(0)}
          </div>
          {authorUrl ? (
            <a href={authorUrl} rel="author" class="font-semibold text-[#141715] underline decoration-[#c59b27]/70 underline-offset-4 hover:text-[#063b1e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#063b1e] rounded-sm">
              {author}
            </a>
          ) : (
            <span class="font-semibold text-[#141715]">{author}</span>
          )}
        </div>
        <span>•</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {formattedReviewDate && (
          <>
            <span>•</span>
            <span>Revisado: {formattedReviewDate}</span>
          </>
        )}
      </div>
    </header>

    <figure class="mb-12 rounded-lg overflow-hidden border border-[#e6e2d8] bg-[#efece3]">
      <img
        src={image}
        alt={imageAlt}
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full aspect-[16/9] object-cover"
      />
      {imageAlt && (
        <figcaption class="p-4 text-center text-xs text-[#5a605c] bg-[#f7f5ed] border-t border-[#e6e2d8]">
          <span class="font-semibold text-[#063b1e]">Lámina de Observación:</span> {imageAlt}
          {imageCredit && <span class="block mt-1 text-[#738a7d]">Crédito: {imageCredit}</span>}
          {imageLicense && (
            <a class="block mt-1 text-[#738a7d] underline underline-offset-2 hover:text-[#063b1e]" href={imageLicense} rel="noopener noreferrer" target="_blank">
              Ver licencia de la imagen
            </a>
          )}
        </figcaption>
      )}
    </figure>

    {tocHeadings.length > 1 && (
      <nav class="mb-10 rounded-lg border border-[#e6e2d8] bg-[#f4efe4] p-5 sm:p-6" aria-label="Índice del artículo">
        <h2 class="font-serif text-xl font-bold text-[#063b1e] mb-3">En este artículo</h2>
        <ol class="space-y-2 text-sm text-[#444a46]">
          {tocHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'pl-4' : ''}>
              <a class="underline decoration-[#c59b27]/70 underline-offset-4 hover:text-[#063b1e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#063b1e] rounded-sm" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <AdBanner layout="in-article" slotId={ADSENSE_SLOTS.articleTop} className="my-10" />

    <div class="article-prose">
      <slot />
    </div>

    <AdBanner layout="in-article" slotId={ADSENSE_SLOTS.articleBottom} className="my-12" />

    {sources.length > 0 && (
      <section class="mt-12 pt-8 border-t border-[#e6e2d8]" aria-labelledby="fuentes-title">
        <h2 id="fuentes-title" class="font-serif text-2xl font-bold text-[#063b1e] mb-4">{reviewedDate ? 'Fuentes y revisión' : 'Fuentes para consultar'}</h2>
        <p class="text-sm text-[#5a605c] leading-relaxed mb-5">
          {reviewedDate
            ? 'Las fuentes enlazadas respaldan la revisión editorial registrada en esta ficha.'
            : 'Las fuentes enlazadas permiten consultar la investigación utilizada. La fecha de revisión se muestra únicamente después de una comprobación editorial específica.'}
        </p>
        <ul class="space-y-3 text-sm">
          {sources.map((source) => (
            <li>
              <a class="font-semibold text-[#063b1e] underline decoration-[#c59b27] underline-offset-4 hover:text-[#785405] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#063b1e] rounded-sm" href={source.url} rel="noopener noreferrer" target="_blank">
                {source.title}
              </a>
              {source.publisher && <span class="text-[#5a605c]"> · {source.publisher}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {tags.length > 0 && (
      <div class="mt-12 pt-6 border-t border-[#e6e2d8] flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase text-[#5a605c] tracking-wide">Índice temático:</span>
        {tags.map((tag) => (
          <span class="bg-[#efece3] text-[#141715] text-xs px-3 py-1 rounded transition-colors">
            #{tag}
          </span>
        ))}
      </div>
    )}

    {relatedArticles.length > 0 && (
      <section class="mt-14 pt-8 border-t border-[#e6e2d8]" aria-labelledby="continua-title">
        <h2 id="continua-title" class="font-serif text-2xl font-bold text-[#063b1e] mb-5">Continúa la exploración</h2>
        <div class="grid gap-4 sm:grid-cols-3">
          {relatedArticles.map((related) => (
            <a href={`/${related.category}/${related.slug}`} class="rounded-lg border border-[#e6e2d8] bg-white p-5 transition-colors hover:border-[#063b1e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#063b1e]">
              <span class="block text-xs font-semibold uppercase tracking-wide text-[#946c07] mb-2">{categoryNames[related.category] || related.category}</span>
              <h3 class="font-serif font-bold leading-snug text-[#141715]">{related.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-[#5a605c]">{related.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-12 p-8 bg-[#f4efe4] rounded-lg border border-[#e6e2d8] flex items-start gap-5">
      <div class="w-14 h-14 rounded bg-[#063b1e] text-[#fbf9f4] flex-shrink-0 flex items-center justify-center font-serif font-bold text-2xl shadow-sm">
        E
      </div>
      <div>
        <h2 class="font-serif font-bold text-[#063b1e] text-lg mb-1.5">{reviewedBy || 'Equipo Editorial EcoCuriosa'}</h2>
        <p class="text-sm text-[#444a46] leading-relaxed">
          {reviewedDate
            ? 'Esta monografía cuenta con una revisión editorial registrada. Si detectas una actualización taxonómica, física o empírica, puedes escribirnos para abrir una nueva revisión documentada.'
            : 'Esta monografía incluye fuentes para consulta. Si detectas una actualización taxonómica, física o empírica, puedes escribirnos para abrir una revisión documentada.'}
        </p>
      </div>
    </section>

  </article>
</BaseLayout>
